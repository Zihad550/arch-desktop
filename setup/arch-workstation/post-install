#!/usr/bin/env bash

# Non-interactive post-install tasks only. This runs via run_step (stdin
# /dev/null, stdout -> log), so it must NOT prompt. The reboot confirmation and
# the user-facing reminders live at the end of init, after ui_done frees the
# terminal.

tldr --update

ARCH_DESKTOP_DIR="${ARCH_DESKTOP_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

"$ARCH_DESKTOP_DIR/bin/df-default-app" set browser zen
"$ARCH_DESKTOP_DIR/bin/df-default-app" set terminal ghostty
"$ARCH_DESKTOP_DIR/bin/df-default-app" set directory-handler nautilus
"$ARCH_DESKTOP_DIR/bin/df-default-app" set file-manager yazi

# Test if AppArmor is correctly enabled.
echo "Is app armor enabled: $(aa-enabled 2>/dev/null || echo 'unknown')"
