#!/usr/bin/env bash
set -euo pipefail

ARCH_DESKTOP_DIR="${ARCH_DESKTOP_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

if [[ ! -d "$DOTFILES_DIR" ]]; then
    git clone --depth 1 https://github.com/Zihad550/dotfiles.git "$DOTFILES_DIR"
fi
if [[ ! -f "$DOTFILES_DIR/zsh/.zshenv" || ! -f "$DOTFILES_DIR/scripts/stow/stow-ai" ]]; then
    echo "not a portable dotfiles checkout: $DOTFILES_DIR" >&2
    exit 1
fi
DOTFILES_DIR="$(cd "$DOTFILES_DIR" && pwd -P)"
if [[ "$DOTFILES_DIR" == "$(cd "$ARCH_DESKTOP_DIR" && pwd -P)" ]]; then
    echo 'arch-desktop and dotfiles must be separate checkouts' >&2
    exit 1
fi
if [[ -e "$ARCH_DESKTOP_DIR/portable" && ! -L "$ARCH_DESKTOP_DIR/portable" ]]; then
    echo "refusing to replace $ARCH_DESKTOP_DIR/portable" >&2
    exit 1
fi
ln -sfn "$DOTFILES_DIR" "$ARCH_DESKTOP_DIR/portable"
printf '%s\n' "$DOTFILES_DIR"
