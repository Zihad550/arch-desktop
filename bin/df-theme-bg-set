#!/bin/bash

set -e

ARCH_DESKTOP_DIR="${ARCH_DESKTOP_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

if [[ -z $1 ]]; then
  echo "Usage: $(basename "$0") <path-to-image>" >&2
  exit 1
fi

BACKGROUND="$(realpath "$1")"
CURRENT_BACKGROUND_LINK="$HOME/.config/theme/background"

if [[ ! -f $BACKGROUND ]]; then
  echo "File does not exist: $BACKGROUND" >&2
  exit 1
fi

ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

"$ARCH_DESKTOP_DIR/bin/df-theme-bg-start" "$CURRENT_BACKGROUND_LINK"

echo "Background set: $(basename "$BACKGROUND")"
